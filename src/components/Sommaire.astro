---
// Sommaire collant d'une page longue : colonne à gauche au bureau, barre de pastilles en haut
// sur téléphone ; la section en cours de lecture est mise en évidence. À placer comme premier
// enfant d'un bloc `.avec-sommaire`, le contenu dans `.sommaire-contenu`. Le slot accueille un
// contrôle propre à la page (bouton). Une seule instance par page.
// Avec `deplier`, un bouton « Tout déplier » ouvre ou ferme les `details[data-deplier]` du
// contenu ; la section en cours de lecture garde sa place à l'écran.
interface Item { id: string; n?: number | string; titre: string; }
// Avec `compact`, les entrées courtes (des lettres) se rangent en grille au bureau.
// Une section masquée (filtre de la page) sort du sommaire ; la page appelle alors
// `rafraichir()` sur la nav.
interface Props { items: Item[]; label: string; deplier?: boolean; compact?: boolean; }
const { items, label, deplier = false, compact = false } = Astro.props;
---
<nav class:list={['sommaire', { 'sommaire-compact': compact }]} aria-label={label} data-pagefind-ignore>
  <ol>
    {items.map((i) => (
      <li><a href={`#${i.id}`} data-sommaire={i.id}>{i.n !== undefined && <span class="sommaire-n">{i.n}</span>}<span class="sommaire-t">{i.titre}</span></a></li>
    ))}
  </ol>
  {deplier && <button type="button" class="tout-deplier" aria-expanded="false" hidden>Tout déplier</button>}
  <slot />
</nav>

<script is:inline>
  (function () {
    function init() {
      var nav = document.querySelector('nav.sommaire');
      if (!nav) return;
      var liste = nav.querySelector('ol');
      var liens = Array.prototype.slice.call(nav.querySelectorAll('a[data-sommaire]'));
      var sections = liens.map(function (a) { return document.getElementById(a.getAttribute('data-sommaire')); });
      if (!liens.length || sections.some(function (s) { return !s; })) return;
      var actif = null;
      function activer(i) {
        if (i === actif) return;
        actif = i;
        liens.forEach(function (a, j) {
          if (j === i) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
        });
        // Barre horizontale (téléphone) : ramène la pastille active en vue, sans bouger la page.
        if (liste.scrollWidth > liste.clientWidth) {
          var ra = liens[i].getBoundingClientRect(), rl = liste.getBoundingClientRect();
          liste.scrollBy({ left: ra.left + ra.width / 2 - (rl.left + rl.width / 2), behavior: 'smooth' });
        }
      }
      // La section active est la dernière dont le haut a passé le tiers de l'écran ; en bas de
      // page, la dernière section.
      function indiceActif() {
        var seuil = window.innerHeight / 3, i = 0;
        sections.forEach(function (s, j) { if (s.offsetParent !== null && s.getBoundingClientRect().top <= seuil) i = j; });
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) i = sections.length - 1;
        return i;
      }
      function calculer() { activer(indiceActif()); }
      nav.rafraichir = function () {
        liens.forEach(function (a, j) { a.parentNode.hidden = sections[j].offsetParent === null; });
        actif = null;
        calculer();
      };
      // Bouton « Tout déplier » : son libellé suit l'état ; les blocs au-dessus de l'écran changent
      // de hauteur, on compense par un défilement de l'écart pour garder la section en place.
      var bouton = nav.querySelector('.tout-deplier');
      var blocs = Array.prototype.slice.call(document.querySelectorAll('details[data-deplier]'));
      function etatBouton() {
        var tous = blocs.length > 0 && blocs.every(function (d) { return d.open; });
        bouton.textContent = tous ? 'Tout replier' : 'Tout déplier';
        bouton.setAttribute('aria-expanded', tous ? 'true' : 'false');
      }
      if (bouton && blocs.length) {
        bouton.hidden = false;
        bouton.addEventListener('click', function () {
          var ouvrir = bouton.getAttribute('aria-expanded') !== 'true';
          var ancre = sections[indiceActif()];
          var avant = ancre.getBoundingClientRect().top;
          blocs.forEach(function (d) { d.open = ouvrir; });
          window.scrollBy(0, ancre.getBoundingClientRect().top - avant);
          etatBouton();
        });
        document.addEventListener('toggle', etatBouton, true);
      }
      var attente = false;
      window.addEventListener('scroll', function () {
        if (attente) return;
        attente = true;
        requestAnimationFrame(function () { attente = false; calculer(); });
      }, { passive: true });
      window.addEventListener('resize', calculer);
      window.addEventListener('load', calculer);
      window.addEventListener('hashchange', calculer);
      document.addEventListener('toggle', calculer, true);
      calculer();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
