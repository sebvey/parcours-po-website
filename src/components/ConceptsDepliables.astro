---
// Les concepts d'un domaine (ou les annexes), chacun dépliable sur ses sous-concepts, lus au
// build dans les pages de concept, avec une flèche qui ouvre le concept. Un concept sans page est « bientôt ».
// Props : `concepts`, ceux d'un domaine de src/data/domaines.ts ; `accroches` (facultatif), une ligne
// par concept sous son titre.
import { inline } from '../lib/inline';
import { disponibles, conceptUrl, sousConcepts } from '../lib/concepts';
import type { ConceptRef } from '../data/domaines';
import { useT } from '../i18n/ui';
interface Props { concepts: ConceptRef[]; accroches?: Record<string, string>; }
const { concepts, accroches = {} } = Astro.props;
const t = useT();
const dispo = await disponibles();
const libelle = (n: string) => (/^A/.test(n) ? 'Annexe' : 'Concept');
---
<ul class="cdep-liste">
  {concepts.map((c) => {
    const e = dispo.get(c.n);
    return (
      <li class="cdep-item">
        {e ? (
          <>
          <details class="cdep" data-deplier>
            <summary><span class="num">{libelle(c.n)} {c.n}</span> <span class="t">{c.titre}</span>{accroches[c.n] && <span class="acc" set:html={inline(accroches[c.n])} />}</summary>
            <ol class="sous-liste">
              {sousConcepts(e).map((s) => (
                <li>
                  <a class="sous-lien" href={conceptUrl(c.n, s.id)}>
                    <span class="ref">{s.id}</span>
                    <span class="corps">
                      <span class="tt" set:html={inline(s.titre)} />
                      {s.promesse && <span class="pq" set:html={inline(s.promesse)} />}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </details>
          <a class="lire-btn" href={conceptUrl(c.n)} aria-label={`Lire le concept ${c.n} : ${c.titre}`}><span aria-hidden="true">→</span></a>
          </>
        ) : (
          <div class="cdep off"><span class="num">{libelle(c.n)} {c.n}</span> <span class="t">{c.titre}</span> <span class="soon">{t('concept.soon')}</span></div>
        )}
      </li>
    );
  })}
</ul>
