---
// Schéma 0 : une frise de sprints (des durées collées les unes aux autres), au-dessus un escalier
// d'incréments (des états du produit, qui s'ajoutent), un sprint détaillé (quatre événements) et
// les trois artefacts avec leur engagement.
// Couleurs : variables CSS --sch-* (clair/sombre) définies dans global.css.
const BASE = 196, STEP = 34, END = 570;
const marches = [
  { x: 60, k: 1, cls: 'm3' },
  { x: 232, k: 2, cls: 'm2' },
  { x: 318, k: 3, cls: 'm1' },
  { x: 456, k: 4, cls: 'm1' },
];
const sprints = [30, 210, 390];
const ticks = Array.from({ length: 10 }, (_, i) => 126 + i * 28);
const lignes = [
  { y: 480, a: 'Backlog produit', b: 'Objectif produit' },
  { y: 524, a: 'Backlog de sprint', b: 'Objectif de sprint' },
  { y: 568, a: 'Incrément', b: 'Definition of Done' },
];
---
<svg viewBox="0 0 600 620" role="img" aria-labelledby="g0-t g0-d" class="sch">
  <title id="g0-t">Un sprint est une durée, un incrément est un état du produit</title>
  <desc id="g0-d">
    En haut, un escalier de quatre marches qui montent de gauche à droite : chaque marche est un incrément, ajouté aux précédents.
    Les marches tombent à des moments variés : une dans le premier sprint, deux dans le deuxième, une dans le troisième.
    Sous l'escalier, une frise de trois sprints de même longueur, collés les uns aux autres, sans pause entre eux : le sprint est une durée.
    Plus bas, un sprint détaillé : le Sprint Planning ouvre le sprint, le Daily Scrum a lieu chaque jour, puis la revue de sprint, puis la rétrospective qui clôt le sprint.
    En bas, un tableau de trois lignes qui associe chaque artefact à son engagement :
    le backlog produit à l'objectif produit, le backlog de sprint à l'objectif de sprint, l'incrément à la Definition of Done.
  </desc>
  <defs>
    <marker id="g0-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" class="arrow-head" />
    </marker>
  </defs>

  <!-- L'escalier des incréments -->
  <text x="30" y="40" class="legend">Chaque marche est un incrément,</text>
  <text x="30" y="62" class="legend">ajouté aux précédents</text>
  {marches.map((m) => (
    <>
      <rect x={m.x} y={BASE - STEP * m.k} width={END - m.x} height={STEP * m.k} class={`marche ${m.cls}`} />
      <text x={m.x + 8} y={BASE - STEP * m.k - 8} class="num">{m.k}</text>
    </>
  ))}

  <!-- La frise des sprints -->
  {sprints.map((x) => (
    <>
      <rect x={x} y="204" width="180" height="46" class="band" />
      <text x={x + 90} y="233" text-anchor="middle" class="layer">sprint</text>
    </>
  ))}
  <text x="30" y="276" class="soft">Sprint : une durée, le suivant commence aussitôt.</text>

  <!-- Un sprint, quatre événements -->
  <text x="30" y="318" class="head">Dans un sprint, quatre événements</text>
  <rect x="30" y="352" width="540" height="40" class="band" />
  <rect x="30" y="352" width="80" height="40" class="ev planning" />
  {ticks.map((x) => (<line x1={x} x2={x} y1="360" y2="384" class="tick" />))}
  <rect x="400" y="352" width="90" height="40" class="ev revue" />
  <rect x="490" y="352" width="80" height="40" class="ev retro" />
  <text x="255" y="340" text-anchor="middle" class="label">Daily Scrum, chaque jour</text>
  <text x="445" y="340" text-anchor="middle" class="label">Revue</text>
  <text x="30" y="416" class="label">Sprint Planning</text>
  <text x="30" y="436" class="soft">ouvre le sprint</text>
  <text x="570" y="416" text-anchor="end" class="label">Rétrospective</text>
  <text x="570" y="436" text-anchor="end" class="soft">clôt le sprint</text>

  <!-- Artefacts et engagements -->
  <text x="30" y="472" class="soft">artefact</text>
  <text x="324" y="472" class="soft">engagement</text>
  {lignes.map((l) => (
    <>
      <rect x="30" y={l.y} width="230" height="38" rx="6" class="band" />
      <text x="145" y={l.y + 25} text-anchor="middle" class="cell">{l.a}</text>
      <line x1="264" x2="318" y1={l.y + 19} y2={l.y + 19} class="link" marker-end="url(#g0-arr)" />
      <rect x="324" y={l.y} width="246" height="38" rx="6" class="engage" />
      <text x="447" y={l.y + 25} text-anchor="middle" class="cell strong">{l.b}</text>
    </>
  ))}
</svg>

<style>
  .sch { font-family: var(--font-ui); }
  .band { fill: var(--sch-band); stroke: var(--sch-band-line); stroke-width: 1.5; }
  .marche { stroke: var(--sch-text); stroke-opacity: 0.35; stroke-width: 1.5; }
  .marche.m1 { fill: var(--sch-s1); }
  .marche.m2 { fill: var(--sch-s2); }
  .marche.m3 { fill: var(--sch-s3); }
  .num { font-size: 19px; font-weight: 700; fill: var(--sch-text); }
  .legend { font-size: 17px; fill: var(--sch-text-soft); }
  .layer { font-size: 19px; font-weight: 600; fill: var(--sch-text); }
  .soft { font-size: 16px; fill: var(--sch-text-soft); }
  .head { font-size: 18px; font-weight: 650; fill: var(--sch-text); }
  .label { font-size: 17px; font-weight: 600; fill: var(--sch-text); }
  .ev.planning { fill: var(--sch-s1); }
  .ev.revue { fill: var(--sch-s2); }
  .ev.retro { fill: var(--sch-s3); }
  .tick { stroke: var(--sch-grey-line); stroke-width: 3; stroke-linecap: round; }
  .cell { font-size: 18px; fill: var(--sch-text); }
  .cell.strong { font-weight: 650; }
  .engage { fill: var(--sch-band); stroke: var(--sch-s1); stroke-width: 2.5; }
  .link { stroke: var(--sch-grey-line); stroke-width: 2.5; fill: none; }
  .arrow-head { fill: var(--sch-grey-line); }
</style>
