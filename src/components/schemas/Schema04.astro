---
// Schéma 4 : l'arbre des niveaux, sur un exemple illustratif. Un epic à la racine, une feature et ses deux
// stories, une story directement sous l'epic, deux tâches grisées sous une story. À droite, le compte de
// « je veux » qui désigne chaque niveau. En bandeau : le Scrum Guide ne connaît pas de niveaux.
// Couleurs : variables CSS --sch-* (clair/sombre) définies dans global.css.
const rows = [
  { c: 63, name: 'EPIC', l1: 'plusieurs groupes,', l2: 'ou pas tous écrits', k: 'epic' },
  { c: 161, name: 'FEATURE', l1: 'plusieurs, chacun', l2: 'utile seul', k: 'feat' },
  { c: 261, name: 'STORY', l1: 'un seul, qui tient', l2: 'dans un sprint', k: 'story' },
  { c: 368, name: 'TÂCHE', l1: 'aucun : l’utilisateur', l2: 'ne la voit pas', k: 'task' },
];
---
<svg viewBox="0 0 600 500" role="img" aria-labelledby="g4-t g4-d" class="sch">
  <title id="g4-t">L'arbre des niveaux du backlog : epic, feature, story, tâche</title>
  <desc id="g4-d">
    Un arbre qui descend, sur un exemple : informer les abonnés avant leur départ.
    À la racine, un epic : informer les abonnés avant leur départ. Dessous, une feature : disponibilité d'une station,
    avec deux stories en feuilles : voir s'il reste un vélo, et voir s'il reste une place libre.
    Une troisième story, être prévenu quand ma station se vide, se rattache directement à l'epic, sans feature.
    Sous la première story, deux tâches grisées en pointillés, lire les relevés et calculer par station,
    légendées : plan des Developers, backlog de sprint.
    À droite, en face de chaque niveau, le compte de « je veux » qui le désigne :
    epic, plusieurs groupes ou pas tous écrits ; feature, plusieurs, chacun utile seul ;
    story, un seul, qui tient dans un sprint ; tâche, aucun, l'utilisateur ne la voit pas.
    En bandeau : le Scrum Guide ne connaît que des éléments du backlog, sans niveau ;
    les noms des niveaux sont un choix d'équipe.
  </desc>

  <text x="456" y="20" class="head">« je veux » à livrer</text>
  <path d="M446 30 V420" class="sep" />

  <!-- Liens -->
  <g class="link">
    <path d="M225 90 V112 H149 V134" />
    <path d="M225 112 H374 V232" />
    <path d="M149 188 V210 H76 V232" />
    <path d="M149 210 H222 V232" />
    <path d="M20 290 V389" class="task-link" />
    <path d="M20 347 H30" class="task-link" />
    <path d="M20 389 H30" class="task-link" />
  </g>

  <!-- Epic -->
  <rect x="20" y="36" width="410" height="54" rx="6" class="node epic" />
  <text x="225" y="68" text-anchor="middle" class="node-text">Informer les abonnés avant leur départ</text>

  <!-- Feature -->
  <rect x="74" y="134" width="150" height="54" rx="6" class="node feat" />
  <text x="149" y="158" text-anchor="middle" class="node-text">Disponibilité</text>
  <text x="149" y="178" text-anchor="middle" class="node-text">d'une station</text>

  <!-- Stories -->
  <rect x="6" y="232" width="140" height="58" rx="6" class="node story" />
  <text x="76" y="257" text-anchor="middle" class="node-text">Voir s'il reste</text>
  <text x="76" y="277" text-anchor="middle" class="node-text">un vélo</text>
  <rect x="152" y="232" width="140" height="58" rx="6" class="node story" />
  <text x="222" y="257" text-anchor="middle" class="node-text">Voir s'il reste</text>
  <text x="222" y="277" text-anchor="middle" class="node-text">une place libre</text>
  <rect x="304" y="232" width="140" height="58" rx="6" class="node story" />
  <text x="374" y="257" text-anchor="middle" class="node-text">Être alerté des</text>
  <text x="374" y="277" text-anchor="middle" class="node-text">stations vides</text>

  <!-- Tâches -->
  <rect x="30" y="330" width="150" height="34" rx="5" class="node task" />
  <text x="105" y="353" text-anchor="middle" class="task-text">Lire les relevés</text>
  <rect x="30" y="372" width="150" height="34" rx="5" class="node task" />
  <text x="105" y="395" text-anchor="middle" class="task-text">Calculer par station</text>
  <text x="194" y="361" class="note">plan des Developers,</text>
  <text x="194" y="381" class="note">backlog de sprint</text>

  <!-- Compte de « je veux » par niveau -->
  {rows.map((r) => (
    <>
      <text x="456" y={r.c - 12} class={`lvl ${r.k}`}>{r.name}</text>
      <text x="456" y={r.c + 7} class="count">{r.l1}</text>
      <text x="456" y={r.c + 26} class="count">{r.l2}</text>
    </>
  ))}

  <!-- Bandeau -->
  <rect x="6" y="436" width="588" height="58" rx="6" class="banner" />
  <text x="300" y="462" text-anchor="middle" class="banner-text"><tspan class="strong">Scrum Guide</tspan> : des éléments du backlog, sans niveau.</text>
  <text x="300" y="484" text-anchor="middle" class="banner-text">Les noms des niveaux sont un choix d'équipe.</text>
</svg>

<style>
  .sch { font-family: var(--font-ui); }
  .head { font-size: 16px; font-weight: 700; fill: var(--sch-text-soft); }
  .sep { stroke: var(--sch-band-line); stroke-width: 1.5; }
  .link path { stroke: var(--sch-text-soft); stroke-width: 2.2; fill: none; }
  .link .task-link { stroke: var(--sch-grey-line); stroke-dasharray: 5 4; }
  .node { fill: var(--sch-band); stroke-width: 3.5; }
  .node.epic { stroke: var(--sch-s1); }
  .node.feat { stroke: var(--sch-s2); }
  .node.story { stroke: var(--sch-s3); }
  .node.task { fill: none; stroke: var(--sch-grey-line); stroke-width: 2.2; stroke-dasharray: 6 4; }
  .node-text { font-size: 17px; font-weight: 600; fill: var(--sch-text); }
  .task-text { font-size: 16px; fill: var(--sch-text-soft); }
  .note { font-size: 16px; font-style: italic; fill: var(--sch-text-soft); }
  .lvl { font-size: 16px; font-weight: 800; letter-spacing: 0.04em; }
  .lvl.epic { fill: var(--sch-s1); }
  .lvl.feat { fill: var(--sch-s2); }
  .lvl.story { fill: var(--sch-text); }
  .lvl.task { fill: var(--sch-text-soft); }
  .count { font-size: 15.5px; fill: var(--sch-text); }
  .banner { fill: var(--sch-band); stroke: var(--sch-band-line); stroke-width: 1.5; }
  .banner-text { font-size: 17.5px; fill: var(--sch-text); }
  .banner-text .strong { font-weight: 700; }
</style>
