---
// Renvois [S1], [S2] vers la liste des références de l'onglet Sources. Props : `refs`. Invariant :
// la page porte les ancres `ref-<id>` (composant Sources) ; `npm run verify` signale une ancre absente.
interface Props { refs: string[]; }
const { refs } = Astro.props;
---
{refs.length > 0 && (
  <span class="refs" data-pagefind-ignore>
    {refs.map((r, i) => (<>{i > 0 && ' '}<a href={`#ref-${r}`}>[{r}]</a></>))}
  </span>
)}
