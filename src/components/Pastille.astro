---
// Pastille de nature : consensus, choix d'école, choix du cours. Props : `kind`. Libellés dans
// src/i18n/ui.ts, couleurs dans les jetons --p-* de global.css ; ignorée par Pagefind.
import { useT } from '../i18n/ui';
interface Props { kind: 'consensus' | 'ecole' | 'cours'; }
const { kind } = Astro.props;
const t = useT();
const label = t(`pastille.${kind}` as const);
---
<span class={`pastille ${kind}`} data-pagefind-ignore>{label}</span>
