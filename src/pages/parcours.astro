---
import Base from '../layouts/Base.astro';
import { blocs, tousLesConcepts } from '../data/parcours';
import { disponibles, conceptUrl } from '../lib/concepts';
import { objectifs, objectifsDe } from '../data/objectifs';
import { useT } from '../i18n/ui';
const t = useT();
const dispo = await disponibles();
---
<Base title="Parcours" nav="path" description="La carte du cours : huit blocs et dix-huit concepts, du cadre du produit à l’exploration.">
  <div class="container-wide">
    <section class="page">
      <p class="eyebrow">La carte du cours</p>
      <h1>Parcours</h1>
      <p class="lead">Dix-huit concepts en huit blocs, plus deux annexes. Chaque bloc répond à une question. Les concepts s’enchaînent dans cet ordre, chacun s’appuyant sur les précédents.</p>
      <div class="filtre-obj" data-pagefind-ignore hidden>
        <p class="filtre-titre" id="filtre-titre">Voir la carte par objectif du cours</p>
        <div class="filtre-boutons" role="group" aria-labelledby="filtre-titre">
          <button type="button" data-obj="" aria-pressed="true">Tous</button>
          {objectifs.map((o) => (<button type="button" data-obj={String(o.n)} aria-pressed="false" title={o.titre}>Objectif {o.n}</button>))}
        </div>
        <p class="filtre-etat" id="filtre-etat" role="status" aria-live="polite"></p>
      </div>

      <div id="carte">
      {blocs.map((b, i) => (
        <section class="bloc" aria-labelledby={`bloc-${b.id}`}>
          <div>
            <p class="n">{b.id === 'annexes' ? 'Annexes' : `Bloc ${i + 1}`}</p>
            <h2 id={`bloc-${b.id}`}>{b.titre}</h2>
            <p class="q">{b.question}</p>
          </div>
          <ul class="cards">
            {b.concepts.map((c) => {
              const e = dispo.get(c.n);
              return (
                <li data-objectifs={objectifsDe(c.n).map((o) => o.n).join(' ')}>
                  {e ? (
                    <a class="card" href={conceptUrl(c.n)}>
                      <span class="num">{/^A/.test(c.n) ? 'Annexe' : 'Concept'} {c.n}</span>
                      <span class="t">{c.titre}</span>
                      <span class="st">Lire le concept</span>
                    </a>
                  ) : (
                    <div class="card off">
                      <span class="num">{/^A/.test(c.n) ? 'Annexe' : 'Concept'} {c.n}</span>
                      <span class="t">{c.titre}</span>
                      <span class="st">{t('concept.soon')}</span>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))}
      </div>

      <section class="objectifs-cours" id="objectifs" aria-labelledby="h-objectifs">
        <h2 id="h-objectifs">Les sept objectifs du cours</h2>
        <p class="sec-intro">À la fin du cours, on sait faire ce qui suit. Chaque objectif est servi par plusieurs concepts, et un concept peut servir plusieurs objectifs. Le concept 3 et les annexes soutiennent l’ensemble sans porter d’objectif en propre.</p>
        <ol class="obj-liste">
          {objectifs.map((o) => (
            <li id={`objectif-${o.n}`}>
              <h3><span class="obj-n">Objectif {o.n}</span> {o.titre}</h3>
              <p>{o.texte}</p>
              <p class="obj-concepts">
                <span class="lib">Concepts :</span>
                {o.concepts.map((n) => {
                  const c = tousLesConcepts.find((x) => x.n === n);
                  return <a class="chip" href={conceptUrl(n)} title={c?.titre}>{n}<span class="chip-ref"> {c?.titre}</span></a>;
                })}
              </p>
            </li>
          ))}
        </ol>
      </section>
    </section>
  </div>

  <script is:inline define:vars={{ objectifsData: objectifs.map((o) => ({ n: String(o.n), titre: o.titre })) }}>
    (function () {
      var bar = document.querySelector('.filtre-obj');
      if (!bar) return;
      bar.hidden = false;
      var boutons = Array.prototype.slice.call(bar.querySelectorAll('button'));
      var etat = document.getElementById('filtre-etat');
      var cartes = Array.prototype.slice.call(document.querySelectorAll('#carte li[data-objectifs]'));
      var blocs = Array.prototype.slice.call(document.querySelectorAll('#carte .bloc'));
      function appliquer(n, pousser) {
        boutons.forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-obj') === n ? 'true' : 'false'); });
        var visibles = 0;
        cartes.forEach(function (li) {
          var ok = !n || li.getAttribute('data-objectifs').split(' ').indexOf(n) >= 0;
          li.hidden = !ok;
          if (ok) visibles++;
        });
        blocs.forEach(function (b) {
          b.hidden = !b.querySelector('li[data-objectifs]:not([hidden])');
        });
        if (!n) { etat.textContent = ''; }
        else {
          var o = objectifsData.filter(function (x) { return x.n === n; })[0];
          etat.textContent = 'Objectif ' + n + ' : ' + o.titre + '. ' + visibles + (visibles > 1 ? ' concepts' : ' concept') + ' sur la carte.';
        }
        if (pousser) history.replaceState(null, '', n ? '#objectif-' + n : location.pathname + location.search);
      }
      boutons.forEach(function (b) {
        b.addEventListener('click', function () { appliquer(b.getAttribute('data-obj'), true); });
      });
      function depuisHash() {
        var m = location.hash.match(/^#objectif-(\d+)$/);
        if (m && boutons.some(function (b) { return b.getAttribute('data-obj') === m[1]; })) {
          appliquer(m[1], false);
          // Après le saut d'ancre du navigateur, on ramène la barre de filtre en vue.
          setTimeout(function () { bar.scrollIntoView(); }, 0);
        }
      }
      depuisHash();
      window.addEventListener('load', function () { if (/^#objectif-\d+$/.test(location.hash)) setTimeout(function () { bar.scrollIntoView(); }, 0); });
      window.addEventListener('hashchange', depuisHash);
    })();
  </script>
</Base>
