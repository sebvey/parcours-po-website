---
import Base from '../layouts/Base.astro';
import { blocs } from '../data/parcours';
import { disponibles, conceptUrl } from '../lib/concepts';
import { useT } from '../i18n/ui';
const t = useT();
const dispo = await disponibles();
---
<Base title="Parcours" nav="path" description="La carte du cours : huit blocs et dix-huit concepts, du cadre du produit à l’exploration.">
  <div class="container-wide">
    <section class="page">
      <p class="eyebrow">La carte du cours</p>
      <h1>Parcours</h1>
      <p class="lead">Dix-huit concepts en huit blocs, plus deux annexes. Chaque bloc répond à une question. Les concepts s’enchaînent dans cet ordre, chacun s’appuyant sur les précédents.</p>
      {blocs.map((b, i) => (
        <section class="bloc" aria-labelledby={`bloc-${b.id}`}>
          <div>
            <p class="n">{b.id === 'annexes' ? 'Annexes' : `Bloc ${i + 1}`}</p>
            <h2 id={`bloc-${b.id}`}>{b.titre}</h2>
            <p class="q">{b.question}</p>
          </div>
          <ul class="cards">
            {b.concepts.map((c) => {
              const e = dispo.get(c.n);
              return (
                <li>
                  {e ? (
                    <a class="card" href={conceptUrl(c.n)}>
                      <span class="num">Concept {c.n}</span>
                      <span class="t">{c.titre}</span>
                      <span class="st">Lire le concept</span>
                    </a>
                  ) : (
                    <div class="card off">
                      <span class="num">Concept {c.n}</span>
                      <span class="t">{c.titre}</span>
                      <span class="st">{t('concept.soon')}</span>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </section>
  </div>
</Base>
