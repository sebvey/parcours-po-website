---
import Base from '../layouts/Base.astro';
import Pastille from '../components/Pastille.astro';
import Position from '../components/Position.astro';
import Sommaire from '../components/Sommaire.astro';
import '../styles/transversal.css';
import { positions, scinde, groupeConsensus, slug, type Position as Pos } from '../lib/transversal';

const toutes = await positions();
const par = (kind: Pos['kind']) => toutes.filter((p) => p.kind === kind);
const consensus = par('consensus');
const ecole = par('ecole');
const cours = par('cours');

interface Groupe { titre: string; id: string; items: { p: Pos; sujet?: string }[] }
const cmp = (a: string, b: string) => a.localeCompare(b, 'fr', { sensitivity: 'base' });

function grouper(items: Pos[], cle: (p: Pos) => { groupe: string; sujet?: string }, premier?: string, dernier?: string): Groupe[] {
  const m = new Map<string, Groupe>();
  for (const p of items) {
    const { groupe, sujet } = cle(p);
    if (!m.has(groupe)) m.set(groupe, { titre: groupe, id: slug(groupe), items: [] });
    // Pas de sujet quand il répète le titre du groupe.
    m.get(groupe)!.items.push({ p, sujet: sujet === groupe ? undefined : sujet });
  }
  const rang = (g: Groupe) => (g.titre === premier ? 0 : g.titre === dernier ? 2 : 1);
  return [...m.values()].sort((a, b) => rang(a) - rang(b) || cmp(a.titre, b.titre));
}

const AUTRES = 'Positions sans auteur unique';
const gConsensus = grouper(
  consensus,
  (p) => ({ groupe: groupeConsensus(p.auteur), sujet: scinde(p.auteur).sujet }),
  'Le Scrum Guide 2020',
);
const gEcole = grouper(
  ecole,
  (p) => {
    const { groupe, sujet } = scinde(p.auteur);
    return groupe ? { groupe, sujet } : { groupe: AUTRES, sujet };
  },
  undefined,
  AUTRES,
);
// Choix du cours : par concept, dans l'ordre du cours.
const gCours: Groupe[] = [];
for (const p of cours) {
  const titre = `Concept ${p.n} · ${p.titre}`;
  let g = gCours.find((x) => x.titre === titre);
  if (!g) { g = { titre, id: `c-${slug(p.n)}`, items: [] }; gCours.push(g); }
  g.items.push({ p });
}

const sections = [
  { kind: 'consensus', id: 'consensus', titre: 'Consensus', groupes: gConsensus, n: consensus.length, intro: 'Groupées par texte de référence ou par pratique.' },
  { kind: 'ecole', id: 'ecoles', titre: 'Choix d’école', groupes: gEcole, n: ecole.length, intro: 'Rangées par auteur ou par école, posées côte à côte.' },
  { kind: 'cours', id: 'cours', titre: 'Choix du cours', groupes: gCours, n: cours.length, intro: 'Groupées par concept, dans l’ordre du cours.' },
] as const;
const items = sections.map((s) => ({ id: s.id, titre: `${s.titre} (${s.n})` }));
---
<Base title="Consensus ou école" nav="ecoles" description="Toutes les positions du cours, par nature : ce qui fait consensus, ce qui relève d’un choix d’école, ce que le cours décide lui-même.">
  <div class="container-wide">
    <section class="page index-page">
      <p class="eyebrow">Index transversal</p>
      <h1>Consensus ou école</h1>
      <p class="lead">Les {toutes.length} positions du cours, rangées selon ce qui les fonde. Chacune renvoie à l’endroit du concept où elle est posée.</p>

      <dl class="legende" data-pagefind-ignore>
        <div><dt><Pastille kind="consensus" /></dt><dd>Ce que disent les textes de référence et ce que les praticiens font en général.</dd></div>
        <div><dt><Pastille kind="ecole" /></dt><dd>Une position défendable, portée par un auteur ou une école, à côté d’autres : le lecteur voit qui la défend.</dd></div>
        <div><dt><Pastille kind="cours" /></dt><dd>Un choix que le cours fait lui-même, sans source externe qui l’impose.</dd></div>
      </dl>

      <div class="avec-sommaire">
        <Sommaire items={items} label="Natures des positions" deplier />
        <div class="sommaire-contenu">
          {sections.map((s) => (
            <section class={`fr-section index-sec ${s.kind}`} id={s.id} aria-labelledby={`h-${s.id}`}>
              <h2 id={`h-${s.id}`}>{s.titre}</h2>
              <p class="sec-intro"><Pastille kind={s.kind} /> {s.n} positions, {s.intro.charAt(0).toLowerCase() + s.intro.slice(1)}</p>
              {s.kind === 'ecole' ? (
                // La plupart des auteurs n'ont qu'une position : une liste à plat, l'auteur en tête.
                <ul class="pos-liste pos-plate">
                  {s.groupes.flatMap((g) => g.items.map((it) => (
                    <Position p={it.p} sujet={g.titre === AUTRES ? it.sujet : (it.sujet ? `${g.titre} : ${it.sujet}` : g.titre)} />
                  )))}
                </ul>
              ) : (
              <ul class="cdep-liste">
                {s.groupes.map((g) => (
                  <li class="cdep-item" id={`${s.kind}-${g.id}`}>
                    <details class="cdep" data-deplier>
                      <summary><span class="t">{g.titre}</span> <span class="src-nb">{g.items.length} {g.items.length > 1 ? 'positions' : 'position'}</span></summary>
                      <ul class="pos-liste">
                        {g.items.map((it) => (<Position p={it.p} sujet={it.sujet} court={s.kind === 'cours'} />))}
                      </ul>
                    </details>
                  </li>
                ))}
              </ul>
              )}
            </section>
          ))}
        </div>
      </div>
    </section>
  </div>
</Base>
