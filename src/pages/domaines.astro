---
import Base from '../layouts/Base.astro';
import '../styles/transversal.css';
import { inline } from '../lib/inline';
import { domaines, annexes, domaineId } from '../data/domaines';
import { disponibles, conceptUrl, sousConcepts } from '../lib/concepts';
import { useT } from '../i18n/ui';
const t = useT();
const dispo = await disponibles();
const libelle = (n: string) => (/^A/.test(n) ? 'Annexe' : 'Concept');
const tous = [...domaines, annexes];
---
<Base title="Domaines" nav="domaines" description="Le cours en sept domaines, du cadre du produit à l’exploration : ce qu’on sait faire à la fin de chacun, ses concepts et leurs sections.">
  <div class="container-wide">
    <section class="page tr">
      <p class="eyebrow">La carte du cours</p>
      <h1>Domaines</h1>
      <p class="lead">Le cours se lit dans l’ordre, domaine après domaine. Déployez un concept pour voir ses sections et aller droit à celle qui vous sert.</p>

      <div class="dom-layout">
        <nav class="dom-toc" aria-label="Domaines" data-pagefind-ignore>
          <ol>
            {tous.map((d) => (
              <li><a href={`#${domaineId(d)}`} data-toc={domaineId(d)}>{d.n > 0 && <span class="toc-n">{d.n}</span>}<span class="toc-t">{d.titre}</span></a></li>
            ))}
          </ol>
          <button type="button" class="tout-deplier" aria-expanded="false" hidden>Tout déplier</button>
        </nav>

        <div class="dom-contenu">
          {tous.map((d) => (
            <section class="domaine" id={domaineId(d)} aria-labelledby={`${domaineId(d)}-t`}>
              <p class="n">{d.n === 0 ? 'Hors domaines' : `Domaine ${d.n}`}</p>
              <h2 id={`${domaineId(d)}-t`}>{d.titre}<a class="ancre" href={`#${domaineId(d)}`} aria-label={`Lien vers : ${d.titre}`}>#</a></h2>
              <p class="q">{d.n === 0 ? d.saitFaire : <>À la fin, vous savez : {d.saitFaire.charAt(0).toLowerCase() + d.saitFaire.slice(1)}</>}</p>
              <ul class="cdep-liste">
                {d.concepts.map((c) => {
                  const e = dispo.get(c.n);
                  return (
                    <li>
                      {e ? (
                        <details class="cdep">
                          <summary><span class="num">{libelle(c.n)} {c.n}</span> <span class="t">{c.titre}</span></summary>
                          <ol class="sous-liste">
                            {sousConcepts(e).map((s) => (
                              <li>
                                <a class="sous-lien" href={conceptUrl(c.n, s.id)}>
                                  <span class="ref">{s.id}</span>
                                  <span class="corps">
                                    <span class="tt" set:html={inline(s.titre)} />
                                    {s.promesse && <span class="pq" set:html={inline(s.promesse)} />}
                                  </span>
                                </a>
                              </li>
                            ))}
                          </ol>
                          <p class="lire"><a href={conceptUrl(c.n)}>Lire le concept {c.n}</a></p>
                        </details>
                      ) : (
                        <div class="cdep off"><span class="num">{libelle(c.n)} {c.n}</span> <span class="t">{c.titre}</span> <span class="soon">{t('concept.soon')}</span></div>
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      // Anciennes adresses des lectures rapides : #domaine-3-lecture -> #domaine-3.
      function ancienneAdresse() {
        var m = location.hash.match(/^#((?:domaine-\d+)|annexes)-lecture$/);
        if (!m) return;
        history.replaceState(null, '', '#' + m[1]);
        var cible = document.getElementById(m[1]);
        if (cible) cible.scrollIntoView();
      }
      ancienneAdresse();
      window.addEventListener('hashchange', ancienneAdresse);
      // Bouton « Tout déplier » : ouvre ou ferme tous les concepts ; son libellé suit l'état.
      var bouton = document.querySelector('.tout-deplier');
      var concepts = Array.prototype.slice.call(document.querySelectorAll('details.cdep'));
      function etatBouton() {
        var tous = concepts.length > 0 && concepts.every(function (d) { return d.open; });
        bouton.textContent = tous ? 'Tout replier' : 'Tout déplier';
        bouton.setAttribute('aria-expanded', tous ? 'true' : 'false');
      }
      if (bouton && concepts.length) {
        bouton.hidden = false;
        bouton.addEventListener('click', function () {
          var ouvrir = bouton.getAttribute('aria-expanded') !== 'true';
          concepts.forEach(function (d) { d.open = ouvrir; });
          etatBouton();
        });
        document.addEventListener('toggle', etatBouton, true);
      }
      // Sommaire : met en évidence le domaine en cours de lecture.
      var liens = Array.prototype.slice.call(document.querySelectorAll('.dom-toc a[data-toc]'));
      var toc = document.querySelector('.dom-toc ol');
      if (!liens.length) return;
      var sections = liens.map(function (a) { return document.getElementById(a.getAttribute('data-toc')); });
      var actif = null;
      function activer(i) {
        if (i === actif) return;
        actif = i;
        liens.forEach(function (a, j) {
          if (j === i) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
        });
        // Barre horizontale (téléphone) : ramène la pastille active en vue, sans bouger la page.
        var a = liens[i];
        if (toc.scrollWidth > toc.clientWidth) {
          var ra = a.getBoundingClientRect(), rt = toc.getBoundingClientRect();
          toc.scrollBy({ left: ra.left + ra.width / 2 - (rt.left + rt.width / 2), behavior: 'smooth' });
        }
      }
      // Le domaine actif est le dernier dont le haut a passé le tiers de l'écran ; en bas de
      // page, le dernier domaine.
      function calculer() {
        var seuil = window.innerHeight / 3, i = 0;
        sections.forEach(function (s, j) { if (s.getBoundingClientRect().top <= seuil) i = j; });
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) i = sections.length - 1;
        activer(i);
      }
      var attente = false;
      window.addEventListener('scroll', function () {
        if (attente) return;
        attente = true;
        requestAnimationFrame(function () { attente = false; calculer(); });
      }, { passive: true });
      window.addEventListener('resize', calculer);
      document.addEventListener('toggle', calculer, true);
      calculer();
    })();
  </script>
</Base>
