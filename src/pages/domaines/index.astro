---
import Base from '../../layouts/Base.astro';
import '../../styles/transversal.css';
import { domaines, annexes, domaineId } from '../../data/domaines';
import { domaineUrl } from '../../lib/lecture';
import Sommaire from '../../components/Sommaire.astro';
import Fleche from '../../icons/fleche.svg';
import ConceptsDepliables from '../../components/ConceptsDepliables.astro';
const items = [...domaines, annexes].map((d) => ({ id: domaineId(d), n: d.n > 0 ? d.n : undefined, titre: d.titre }));
const minuscule = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
---
<Base title="Domaines" nav="domaines" description="Le cours en sept domaines, du cadre du produit à l’exploration : ce qu’on sait faire à la fin de chacun, et ses concepts.">
  <div class="container-wide">
    <section class="page tr">
      <p class="eyebrow">La carte du cours</p>
      <h1>Domaines</h1>
      <p class="lead">Le cours se lit dans l’ordre, domaine après domaine. Ouvrez un domaine pour sa présentation, ou dépliez un concept pour aller droit à la section qui vous sert.</p>

      <div class="avec-sommaire">
        <Sommaire items={items} label="Domaines" deplier />

        <div class="sommaire-contenu">
          {domaines.map((d) => (
            <section class="domaine" id={domaineId(d)} aria-labelledby={`${domaineId(d)}-t`}>
              <div class="dom-bloc">
                <a class="dom-carte" href={domaineUrl(d)}>
                  <span class="n">Domaine {d.n}</span>
                  <h2 id={`${domaineId(d)}-t`}>{d.titre}</h2>
                  <span class="q">À la fin, vous savez : {minuscule(d.saitFaire)}</span>
                  <Fleche class="dom-fleche" width="24" height="24" aria-hidden="true" />
                </a>
                <ConceptsDepliables concepts={d.concepts} />
              </div>
            </section>
          ))}

          <section class="domaine" id={domaineId(annexes)} aria-labelledby={`${domaineId(annexes)}-t`}>
            <p class="n">Hors domaines</p>
            <h2 id={`${domaineId(annexes)}-t`}>{annexes.titre}<a class="ancre" href={`#${domaineId(annexes)}`} aria-label={`Lien vers : ${annexes.titre}`}>#</a></h2>
            <p class="q">{annexes.saitFaire}</p>
            <ConceptsDepliables concepts={annexes.concepts} />
          </section>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      // Anciennes adresses des lectures rapides : #domaine-3-lecture -> #domaine-3.
      function ancienneAdresse() {
        var m = location.hash.match(/^#((?:domaine-\d+)|annexes)-lecture$/);
        if (!m) return;
        history.replaceState(null, '', '#' + m[1]);
        var cible = document.getElementById(m[1]);
        if (cible) cible.scrollIntoView();
      }
      ancienneAdresse();
      window.addEventListener('hashchange', ancienneAdresse);
    })();
  </script>
</Base>
