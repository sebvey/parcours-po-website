---
import Base from '../layouts/Base.astro';
import Sommaire from '../components/Sommaire.astro';
import '../styles/transversal.css';
import { bibliographie } from '../lib/transversal';
import { inline } from '../lib/inline';
import { domaines, annexes } from '../data/domaines';
import { disponibles, conceptUrl } from '../lib/concepts';
const { entrees, totalCitations } = await bibliographie();
const dispo = await disponibles();
// Les sources qui portent le cours : citées par au moins 3 concepts.
const SEUIL = 3;
const conceptsDe = (e: (typeof entrees)[number]) =>
  e.citations.filter((c, i, a) => a.findIndex((x) => x.n === c.n) === i);
const piliers = entrees
  .map((e) => ({ e, concepts: conceptsDe(e) }))
  .filter((p) => p.concepts.length >= SEUIL)
  .sort((a, b) => b.concepts.length - a.concepts.length);
const libelle = (n: string) => (/^A/.test(n) ? 'Annexe' : 'Concept');
const norm = (s: string) => s.toLowerCase();
const groupes = [...domaines, annexes].map((d) => ({
  titre: d.n === 0 ? 'Annexes' : `Domaine ${d.n} · ${d.titre}`,
  concepts: d.concepts.filter((c) => dispo.has(c.n)).map((c) => ({ c, s: dispo.get(c.n)!.data.sources })),
}));
const items = [
  { id: 'socle', titre: 'Sur quoi repose le cours' },
  { id: 'lire-source', titre: 'Lire une source' },
  { id: 'par-concept', titre: 'Concept par concept' },
];
---
<Base title="Sources" nav="sources" description="Les sources qui portent le cours, comment lire une source, et pour chaque concept ses références et ce qu’elles ne permettent pas d’établir.">
  <div class="container-wide">
    <section class="page index-page">
      <p class="eyebrow">Index transversal</p>
      <h1>Sources</h1>
      <p class="lead">{entrees.length} documents consultés, cités {totalCitations} fois. Quelques-uns portent le cours ; les autres appuient un concept précis.</p>

      <div class="avec-sommaire">
        <Sommaire items={items} label="Dans cette page" />
        <div class="sommaire-contenu">
          <section class="fr-section" id="socle" aria-labelledby="socle-t">
            <h2 id="socle-t">Sur quoi repose le cours</h2>
            <p class="sec-intro">Les sources citées par au moins {SEUIL} concepts.</p>
            <ol class="biblio">
              {piliers.map(({ e, concepts }) => (
                <li class="bib">
                  <p class="bib-texte">
                    {e.url
                      ? <a href={e.url} rel="noopener"><span set:html={inline(e.texte)} /></a>
                      : <span set:html={inline(e.texte)} />}
                  </p>
                  <p class="bib-meta">{e.types.join(' · ')}</p>
                  <p class="bib-cites">
                    <span class="lib">{concepts.length} concepts</span>
                    <span class="chips">
                      {concepts.map((c) => (
                        <a class="chip" href={c.href} title={`${libelle(c.n)} ${c.n} : ${c.titre}`}>{c.n}</a>
                      ))}
                    </span>
                  </p>
                </li>
              ))}
            </ol>
          </section>

          <section class="fr-section" id="lire-source" aria-labelledby="lire-source-t">
            <h2 id="lire-source-t">Lire une source</h2>
            <p class="sec-intro">Sous chaque référence, son type dit ce qu’elle vaut.</p>
            <dl class="legende-src">
              <dt>primaire</dt><dd>Le texte de l’auteur ou de l’organisme.</dd>
              <dt>secondaire</dt><dd>Une reprise par un tiers sérieux.</dd>
              <dt>marketing</dt><dd>La source vend aussi ce dont elle parle (outil, formation, certification). Elle est fiable pour décrire son offre ; ce qu’elle recommande est à prendre avec recul.</dd>
            </dl>
            <p class="sec-intro">Une précision suit parfois le type (« primaire pour ce que fait l’outil ; marketing pour ce qu’il recommande »). Les faits du fil rouge sont inventés : ils n’ont pas de source.</p>
          </section>

          <section class="fr-section" id="par-concept" aria-labelledby="par-concept-t">
            <h2 id="par-concept-t">Concept par concept</h2>
            <p class="sec-intro">Déployez un concept pour voir ses références et ce qu’elles ne permettent pas d’établir.</p>
            <div class="filtre-sources" data-pagefind-ignore hidden>
              <label for="filtre-src">Filtrer les sources</label>
              <input id="filtre-src" type="search" placeholder="Auteur, titre, adresse ou « concept 9 »" autocomplete="off" />
              <p id="filtre-etat" class="etat" role="status" aria-live="polite"></p>
            </div>
            {groupes.map((g) => (
              <div class="src-groupe">
                <h3>{g.titre}</h3>
                <ul class="cdep-liste">
                  {g.concepts.map(({ c, s }) => (
                    <li class="cdep-item" data-concept={`concept ${c.n}`}>
                      <details class="cdep">
                        <summary><span class="num">{libelle(c.n)} {c.n}</span> <span class="t">{c.titre}</span> <span class="src-nb">{s.references.length} sources{s.nonVerifie.length > 0 && ` · ${s.nonVerifie.length} non vérifiés`}</span></summary>
                        <div class="src-corps">
                          <ol class="reflist">
                            {s.references.map((r) => (
                              <li class="src-ref" data-cherche={norm(`${r.texte} ${r.url ?? ''} ${r.type}`)}>
                                <span class="id">{r.id}</span>
                                <span>
                                  {r.url
                                    ? <a href={r.url} rel="noopener"><span set:html={inline(r.texte)} /></a>
                                    : <span set:html={inline(r.texte)} />}
                                  <span class="meta">{r.type}</span>
                                </span>
                              </li>
                            ))}
                          </ol>
                          {s.nonVerifie.length > 0 && (
                            <div class="src-nv">
                              <p class="src-sous">Non vérifié</p>
                              <ul class="nonverifie">
                                {s.nonVerifie.map((t) => (<li set:html={inline(t)} />))}
                              </ul>
                            </div>
                          )}
                        </div>
                      </details>
                      <a class="lire-btn" href={conceptUrl(c.n, 'sources')} aria-label={`Ouvrir l’onglet Sources du ${libelle(c.n).toLowerCase()} ${c.n}`}>Ouvrir</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <p id="src-vide" class="etat" hidden>Aucune source ne correspond à ce filtre.</p>
          </section>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var box = document.querySelector('.filtre-sources');
      var input = document.getElementById('filtre-src');
      var etat = document.getElementById('filtre-etat');
      var vide = document.getElementById('src-vide');
      var concepts = Array.prototype.slice.call(document.querySelectorAll('#par-concept .cdep-item'));
      var groupes = Array.prototype.slice.call(document.querySelectorAll('#par-concept .src-groupe'));
      if (!box || !input || !concepts.length) return;
      box.hidden = false;
      function norm(s) { return (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); }
      var donnees = concepts.map(function (li) {
        return {
          li: li,
          details: li.querySelector('details'),
          nom: norm(li.getAttribute('data-concept')),
          refs: Array.prototype.slice.call(li.querySelectorAll('.src-ref')).map(function (r) {
            return { el: r, txt: norm(r.getAttribute('data-cherche')) };
          }),
          nv: li.querySelector('.src-nv')
        };
      });
      // Filtre : les concepts qui ont une source correspondante restent, dépliés, avec ces seules
      // sources ; « concept 9 » garde le concept 9 entier.
      function filtrer() {
        var q = norm(input.value).trim().split(/\s+/).filter(Boolean);
        var nb = 0;
        var nomCherche = donnees.some(function (d) { return q.length > 0 && q.join(' ') === d.nom; });
        donnees.forEach(function (d) {
          var nomOk = q.length > 0 && q.join(' ') === d.nom;
          var visibles = 0;
          d.refs.forEach(function (r) {
            var ok = !q.length || nomOk || (!nomCherche && q.every(function (m) { return r.txt.indexOf(m) >= 0; }));
            r.el.hidden = !ok;
            if (ok) visibles++;
          });
          if (d.nv) d.nv.hidden = q.length > 0 && !nomOk;
          d.li.hidden = q.length > 0 && visibles === 0;
          if (q.length) { d.details.open = visibles > 0; nb += visibles; }
        });
        groupes.forEach(function (g) { g.hidden = !g.querySelector('.cdep-item:not([hidden])'); });
        if (!q.length) donnees.forEach(function (d) { d.details.open = false; });
        etat.textContent = q.length ? nb + (nb > 1 ? ' références' : ' référence') : '';
        vide.hidden = !q.length || nb > 0;
      }
      input.addEventListener('input', filtrer);
    })();
  </script>
</Base>
