---
import '../styles/global.css';
import { useT, url, defaultLang, type Lang } from '../i18n/ui';
import { siteVersion, coursVersion } from '../data/version';

interface Props {
  title?: string;
  description?: string;
  /** Entrée de navigation active : 'home' | 'domaines' | 'filrouge' | 'glossaire' | 'ecoles' | 'sources' | 'about' | 'search' */
  nav?: string;
  lang?: Lang;
  /** Exclure la page de l'index de recherche. */
  noindex?: boolean;
}
const { title, description, nav, lang = defaultLang, noindex = false } = Astro.props;
const t = useT(lang);
const fullTitle = title ? `${title} | ${t('site.name')}` : t('site.name');
const desc = description ?? t('site.tagline');
const canonical = new URL(Astro.url.pathname, Astro.site);
// Aperçu : tant que la version est 0.x, le site demande aux moteurs de recherche de ne pas l'indexer.
const preview = siteVersion.startsWith('0.');
const items = [
  { key: 'home', href: url(''), label: t('nav.home') },
  { key: 'domaines', href: url('domaines/'), label: t('nav.domaines') },
  { key: 'filrouge', href: url('fil-rouge/'), label: t('nav.filrouge') },
  { key: 'glossaire', href: url('glossaire/'), label: t('nav.glossary') },
  // --- Pages transversales : index (début)
  { key: 'ecoles', href: url('ecoles/'), label: t('nav.ecoles') },
  { key: 'sources', href: url('sources/'), label: t('nav.sources') },
  // --- Pages transversales : index (fin)
  { key: 'about', href: url('a-propos/'), label: t('nav.about') },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content="fr_FR" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#contenu">{t('skip')}</a>
    <header class="site-header">
      <div class="container-wide bar">
        <a class="brand" href={url('')}>{t('site.name')}</a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-list" hidden>{t('nav.menu')}</button>
        <nav class="site-nav" aria-label={t('nav.main')}>
          <ul id="nav-list">
            {items.map((i) => (
              <li><a href={i.href} aria-current={nav === i.key ? 'page' : undefined}>{i.label}</a></li>
            ))}
            <li class="nav-search-link"><a href={url('recherche/')} aria-current={nav === 'search' ? 'page' : undefined}>{t('nav.search')}</a></li>
          </ul>
        </nav>
        <form class="search-form" role="search" action={url('recherche/')} method="get">
          <label class="sr-only" for="q-header">{t('search.label')}</label>
          <input id="q-header" type="search" name="q" placeholder={t('search.placeholder')} autocomplete="off" />
        </form>
      </div>
    </header>
    <script is:inline>
      (function () {
        var b = document.querySelector('.nav-toggle');
        var l = document.getElementById('nav-list');
        if (!b || !l) return;
        b.hidden = false;
        document.documentElement.classList.add('nav-js');
        b.addEventListener('click', function () {
          var open = b.getAttribute('aria-expanded') === 'true';
          b.setAttribute('aria-expanded', open ? 'false' : 'true');
          l.parentNode.classList.toggle('is-open', !open);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && b.getAttribute('aria-expanded') === 'true') {
            b.setAttribute('aria-expanded', 'false'); l.parentNode.classList.remove('is-open'); b.focus();
          }
        });
      })();
    </script>
    <main id="contenu" data-pagefind-body={noindex ? undefined : ''}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container-wide row">
        <p><a href={t('footer.licenceLink')} rel="license noopener">{t('footer.licence')}</a></p>
        <p>{t('site.name')} · {t('footer.site')} {siteVersion} · {t('footer.cours')} {coursVersion}</p>
      </div>
    </footer>
  </body>
</html>
