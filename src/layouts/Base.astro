---
import '../styles/global.css';
import { useT, url, defaultLang, type Lang } from '../i18n/ui';
import { siteVersion, coursVersion } from '../data/version';
import Marque from '../icons/marque.svg';
import Loupe from '../icons/loupe.svg';
import Soleil from '../icons/soleil.svg';
import Lune from '../icons/lune.svg';

interface Props {
  title?: string;
  description?: string;
  /** Entrée de navigation active : 'home' | 'domaines' | 'filrouge' | 'glossaire' | 'ecoles' | 'sources' | 'about' | 'search' */
  nav?: string;
  lang?: Lang;
  /** Page hors index : ni dans la recherche Pagefind, ni pour les moteurs de recherche (pas d'adresse canonique). */
  noindex?: boolean;
}
const { title, description, nav, lang = defaultLang, noindex = false } = Astro.props;
const t = useT(lang);
const fullTitle = title ? `${title} | ${t('site.name')}` : t('site.name');
const desc = description ?? t('site.tagline');
const canonical = new URL(Astro.url.pathname, Astro.site);
// Aperçu : tant que la version est 0.x, le site demande aux moteurs de recherche de ne pas l'indexer.
const preview = siteVersion.startsWith('0.');
// L'accueil est le lien du nom du site ; À propos est dans le pied de page ; la recherche, un bouton rond.
const items = [
  { key: 'domaines', href: url('domaines/'), label: t('nav.domaines') },
  { key: 'filrouge', href: url('fil-rouge/'), label: t('nav.filrouge') },
  { key: 'glossaire', href: url('glossaire/'), label: t('nav.glossary') },
  // --- Pages transversales : index (début)
  { key: 'ecoles', href: url('ecoles/'), label: t('nav.ecoles') },
  { key: 'sources', href: url('sources/'), label: t('nav.sources') },
  // --- Pages transversales : index (fin)
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {(preview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content="fr_FR" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Thème choisi par le lecteur (bouton de l'en-tête), appliqué avant l'affichage ; sinon, celui du système.
      try {
        var theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#contenu">{t('skip')}</a>
    <header class="site-header">
      <div class="container-wide bar">
        <a class="brand" href={url('')} aria-current={nav === 'home' ? 'page' : undefined}>
          <Marque width="28" height="28" aria-hidden="true" />
          <span class="brand-nom">{t('site.name')}</span>
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-list" hidden>{t('nav.menu')}</button>
        <nav class="site-nav" aria-label={t('nav.main')}>
          <ul id="nav-list">
            {items.map((i) => (
              <li><a href={i.href} aria-current={nav === i.key ? 'page' : undefined}>{i.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="btn-rond search-link" href={url('recherche/')} title={t('search.label')} aria-current={nav === 'search' ? 'page' : undefined}>
          <Loupe width="18" height="18" aria-hidden="true" />
          <span class="sr-only">{t('nav.search')}</span>
        </a>
        <button class="btn-rond theme-toggle" type="button" hidden>
          <Soleil class="icone-soleil" width="18" height="18" aria-hidden="true" />
          <Lune class="icone-lune" width="18" height="18" aria-hidden="true" />
          <span class="sr-only"></span>
        </button>
      </div>
    </header>
    <script is:inline>
      // Bouton clair / sombre : bascule le thème affiché et mémorise le choix.
      (function () {
        var b = document.querySelector('.theme-toggle');
        if (!b) return;
        var racine = document.documentElement;
        var sombreSysteme = window.matchMedia('(prefers-color-scheme: dark)');
        function actuel() { return racine.getAttribute('data-theme') || (sombreSysteme.matches ? 'dark' : 'light'); }
        function maj() {
          var sombre = actuel() === 'dark';
          b.setAttribute('aria-pressed', sombre ? 'true' : 'false');
          b.querySelector('.sr-only').textContent = 'Thème sombre';
          b.title = sombre ? 'Passer au thème clair' : 'Passer au thème sombre';
        }
        b.hidden = false;
        b.addEventListener('click', function () {
          var t = actuel() === 'dark' ? 'light' : 'dark';
          racine.setAttribute('data-theme', t);
          try { localStorage.setItem('theme', t); } catch (e) {}
          maj();
        });
        sombreSysteme.addEventListener('change', maj);
        maj();
      })();
    </script>
    <script is:inline>
      (function () {
        var b = document.querySelector('.nav-toggle');
        var l = document.getElementById('nav-list');
        if (!b || !l) return;
        b.hidden = false;
        document.documentElement.classList.add('nav-js');
        b.addEventListener('click', function () {
          var open = b.getAttribute('aria-expanded') === 'true';
          b.setAttribute('aria-expanded', open ? 'false' : 'true');
          l.parentNode.classList.toggle('is-open', !open);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && b.getAttribute('aria-expanded') === 'true') {
            b.setAttribute('aria-expanded', 'false'); l.parentNode.classList.remove('is-open'); b.focus();
          }
        });
      })();
    </script>
    <main id="contenu" data-pagefind-body={noindex ? undefined : ''}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container-wide row">
        <p>{t('footer.accompagne')} · <a href={url('a-propos/')} aria-current={nav === 'about' ? 'page' : undefined}>{t('nav.about')}</a></p>
        <p class="footer-meta"><a href={t('footer.licenceLink')} rel="license noopener">{t('footer.licence')}</a> · {t('footer.site')} {siteVersion} · {t('footer.cours')} {coursVersion}</p>
      </div>
    </footer>
  </body>
</html>
